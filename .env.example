# Shared secret. n8n sends it as `Authorization: Bearer <token>`. Leave empty only for local testing.
API_TOKEN=

# ----------------------------------------------------------------------------- LANES (0.4.0)
# Every request to Facebook leaves through a lane, and every lane is ONE sticky residential exit
# with its own cookie jars, pacing and limiter. This host's own address is never used: the same
# service answers 01's 50+ checks and 02's research ads, so a block on that address would stop
# the whole pipeline, not just sourcing (Umer, stage0.md, 25 Sep 2026). docs/architecture.md "Lanes".
#
# How many lanes run in parallel. Ramp 1 -> 2 -> 4 -> 8, at least 24 h at each level, stepping
# up only while /health `block_rate_1h` stays under 5 %. Every lane needs its own exit below.
LANE_COUNT=2

# The proxy credential with `{port}` where the lane's sticky port goes. DataImpulse binds one exit
# IP to each port in 10000-20000 for the rotation interval set in its dashboard (1-120 min; set
# 120 so a jar and its IP live as long as SESSION_MAX_AGE_S). `__cr.us` in the username pins the
# exit country. Percent-encode a password that contains ':', '@' or '%'.
LANE_PROXY_TEMPLATE=http://USER__cr.us:PASS@gw.dataimpulse.com:{port}

# Sticky ports, ranges and lists. The first LANE_COUNT become lanes; the rest are the reserve a
# blocked lane rotates onto for a fresh exit IP. Never a rotating gateway port (DataImpulse 823,
# Decodo 7000): refused at startup, because a rotating exit under one cookie jar is the pattern
# Meta refuses. Keep the lanes container's ports disjoint from production's (11500).
LANE_PROXY_PORTS=11510-11529

# Escape hatch when the template does not fit (mixed vendors): full specs, comma-separated, one
# per lane, either `http://user:pass@host:port` or `host:port:user:pass`. Ignored when the
# template is set.
LANE_PROXIES=

# A lane without a proxy refuses to start. Only CI, which has no residential exit and no
# production traffic, sets this false.
LANE_REQUIRE_PROXY=true

# Where a lane learns its exit IP (a ~60 byte GET through its own proxy) at mint and every
# LANE_IP_CHECK_S between items. A changed IP on the same port is the vendor rotating under a
# live jar: both jars are retired, the port is kept. Every log line and /health row names the
# address. Empty disables the check; 0 checks only at mint.
LANE_IP_CHECK_URL=https://api.ipify.org?format=json
LANE_IP_CHECK_S=600

# A hard block (403 without a challenge, a 400 TLS page, two dead jars, a closed breaker) cools the
# lane for LANE_COOLDOWN_S and, when set, moves it to the next reserve port: the IP is what is
# blocked. The cooldown doubles while the probe after it keeps blocking, up to the max; three
# failed probes in a row park the lane as `blocked` until LANE_BLOCKED_RETRY_S has passed.
LANE_ROTATE_ON_BLOCK=true
LANE_COOLDOWN_S=900
LANE_COOLDOWN_MAX_S=3600
LANE_BLOCKED_RETRY_S=3600

# Errors (results missing, network, 5xx) do not cool a lane on their own; this many in a row do,
# briefly, with an exit-ip re-check, because that shape is usually the proxy, not Meta.
LANE_ERROR_COOLDOWN_AFTER=3
LANE_ERROR_COOLDOWN_S=120

# An item refused by a lane (blocked, rate limited, withheld with nothing to recover) is retried
# on a DIFFERENT lane, never the same one twice, this many times in all, then reported `blocked`
# - never `no_ads`. Withheld pages in a row that retire a lane's jars and move it to a fresh port.
LANE_MAX_TRIES=3
LANE_WITHHELD_ROTATE=3

# Per-try budgets, seconds. Short on purpose: a 429 must move the search to another lane, not nap
# RATE_LIMIT_SLEEP_S on the exit that just refused it (the nap only happens when it fits). The
# request budgets below (SCRAPE_BUDGET_S, BRAND_BUDGET_S) still bound a single call end to end.
LANE_SEARCH_BUDGET_S=90
LANE_COUNT_BUDGET_S=20

# Gap between two GraphQL pages on one lane session. The site's own scroll pagination is this
# fast; the rendered-page gap (SPACING_*) would make an 8-page recovery take ~40 s.
GQL_SPACING_MIN_S=1
GQL_SPACING_MAX_S=2

# ----------------------------------------------------------------------------- BATCH JOBS
# POST /jobs takes a whole sourcing run (searches and counts) and the lanes spread it out;
# GET /jobs/{id}?wait_s=45 long-polls for the results paired back by id. Everything in memory.
JOB_MAX_ITEMS=200
JOB_STORE_MAX=50
JOB_QUEUE_MAX=1000
# How long a queued item may wait for a lane before it is answered `error: no lane available`.
JOB_ITEM_MAX_WAIT_S=600
# How long a finished job stays readable, and the longest one poll may hold (under n8n's timeout).
JOB_TTL_S=7200
JOB_POLL_MAX_WAIT_S=50

# POST /fetch: a brand homepage read through a lane exit with the Chrome profile (docs/api.md).
# Fetches run beside the lanes, not on them: their own concurrency and timeout, and the text is
# cut at FETCH_MAX_BYTES so a media-heavy storefront does not bloat the answer.
FETCH_CONCURRENCY=4
FETCH_TIMEOUT_S=15
FETCH_MAX_BYTES=300000

# Retired in 0.4.0 (lanes replaced the direct path and the single recovery exit). Read only to
# warn at startup if still set.
SCRAPER_PROXY=
FALLBACK_PROXY=

# Wall-clock ceiling for ONE paged call (POST /facebook with max_pages > 1), seconds. Measured
# 24 Sep 2026: 150 pages of `skin care` took 783 s, which Stage 0's 300 s node timeout would have
# cut off with nothing to show. A run that stops here answers X-Truncated: 1 with X-Next-Cursor
# and X-Collation; send both back to continue the same search. 0 removes the ceiling and is only
# right for a probe nothing is waiting on.
PAGE_BUDGET_S=240

# Sessions minted in a row on ONE LANE that never returned a page, after which that lane mints no
# more until the cooldown passes. A mint is the most expensive call this service makes, and on
# 24 Sep 2026 it became expensive for nothing: Meta answered 1675004 on the FIRST GraphQL call of
# every fresh session from the proxy exit, and nothing stopped the next keyword minting another.
# Seven sessions in twenty minutes, 136 MB, zero ads. Two in a row that return no page is not a
# session to swap - it is this exit being refused - so the breaker stops paying to find out again.
# 0 disables it, which is how that incident was configured. One breaker per lane.
MINT_FAILURE_LIMIT=2
MINT_COOLDOWN_S=900

# How long one withheld page makes a LANE skip its rendered GET on later searches, seconds. While
# Meta is throttling an exit that GET costs ~3 s and ~1 MB to be told what the previous search
# already established: measured 24 Sep 2026, 24 of the 24 searches with ads to give came back
# empty in one sourcing cycle. Minutes, not hours: one rendered GET per window is the price of
# noticing Meta has stopped. One memory per lane. 0 always checks the rendered page first.
THROTTLE_MEMORY_S=600

# Pages the proxied fallback may take when Meta is withholding the ad payload from this address.
#
# 8, and this was measured the expensive way. Depth does not pay.
#
# Three independent pieces of evidence. Across 10 keywords paged deep on 24 Sep 2026, advertisers
# per page ran from 4.33 (`toddler balance bike`, 6 pages) down to 0.39 (`posture corrector
# device`, 41 pages): the early pages carry distinct advertisers and the tail re-samples the same
# handful - `beard growth kit` spent 89 pages to find 42, at 18.7 ads each. 00's own Select
# Keyword And Country node reached the same conclusion from exec 1014: "the lever is MORE
# KEYWORDS PER RUN, not more ads per keyword". And then this was raised to 20 and run in
# production, cycle 3951 against cycle 3931:
#
#   pages 64 -> 169, decoded 6.62 -> 17.32 MB, run 6m30s -> 13m47s
#   brands_new 25 -> 25, brands_verified 20 -> 16
#
# 2.6x the spend for no new brands. (Different keywords each cycle, so some of that is luck - but
# it agrees with the other two.) Raising this buys the worst pages there are; spend the budget on
# more keywords instead.
FALLBACK_MAX_PAGES=8

# curl_cffi impersonation target. `chrome` is an alias for the newest Chrome the installed curl_cffi
# knows (chrome150 in 0.16.3). Meta rejects non-browser TLS with a 400 error page on every request
# after the challenge, measured 2026-09-19 with plain curl - so this is not a cosmetic setting.
FB_IMPERSONATE=chrome

# Per-request timeout, seconds. Measured 2026-09-19 from the VPS: the search page is 0.6 to 1.7 MB
# and answers in 0.3 to 2.4 s. 30 leaves room for a slow Meta edge without eating the budget below.
REQUEST_TIMEOUT_S=30

# Extra GETs allowed when the page arrives without its results blob. Measured 2026-09-19 from
# both a laptop and the VPS: about 1 in 4 page loads, decided per request on Meta's side; one
# retry recovered it in every case seen. When every attempt misses the search is a 503
# (ResultsMissing), never an empty list, because Stage 0 retires keywords on empty lists.
SSR_RETRIES=2

# Retired in 0.4.0: a lane is one session and one request at a time, and LANE_COUNT is the
# concurrency. Single calls from 01/02 jump the queue ahead of batch items, lookups first, so a
# 40-search job never starves a 25 s lookup; a caller that no lane can serve within its budget
# still gets a 503 (Busy).
#   MAX_CONCURRENCY, SESSION_POOL_SIZE

# A session is retired after this many page GETs or this many seconds, whichever first. Keep the
# age AT OR BELOW the proxy vendor's sticky rotation interval (DataImpulse: 120 min, set in the
# dashboard), so a jar and its exit IP live and die together; a rotation under a live jar is
# caught by the LANE_IP_CHECK and costs a re-mint. Tune from /health: `sessions_retired` by
# reason shows which limit is actually being hit (`ip_rotated` means the interval is shorter).
SESSION_MAX_REQUESTS=200
SESSION_MAX_AGE_S=7200

# Random gap between two calls on the same session, seconds. The site's own scroll pagination
# is human-paced; a fixed 0 s gap is the one pattern that looks nothing like it.
SPACING_MIN_S=2
SPACING_MAX_S=5

# Ceiling on GETs per minute PER LANE (one exit IP), across rendered pages and GraphQL pages and
# both endpoints. The identity Meta sees is the exit, so eight lanes are eight independent
# budgets. Measured 2026-09-22 from one address: 20 page views on one session at 12/min in 96 s,
# then the harness's ~110 lookups in 10 minutes at 20/min, all 200, no challenge after the first,
# no throttle. Every lookup prices the limiter's next slot against its budget, so a saturated
# lane answers a 503 instead of a late page.
RATE_LIMIT_PER_MIN=20

# On an HTTP 429 the session sleeps this long and retries once; a second 429 retires it and a
# fresh session takes over.
RATE_LIMIT_SLEEP_S=60

# A session that gets this many consecutive pages without results is retired as suspect. A real
# empty result (the keyword has no ads) carries an empty results blob and does not count.
MISS_STREAK_RETIRE=5

# Wall-clock ceiling for one search (POST /facebook), seconds. Nothing cancels a request once it
# starts, so the search never starts a GET it cannot finish inside this, and a search that has
# only misses when the budget runs out is a 503. Budget against Stage 0's 300 s node timeout:
#   one GET    = SPACING_MAX_S + REQUEST_TIMEOUT_S + 60/RATE_LIMIT_PER_MIN = 5 + 30 + 3 = 38 s
#   one search = (1 + SSR_RETRIES) x 38 + RATE_LIMIT_SLEEP_S               = 174 s worst case
# 240 sits between that and 300. Keep stop_grace_period in docker-compose.yml above this.
SCRAPE_BUDGET_S=240

# Wall-clock ceiling for one brand lookup (POST /adyntel), seconds. Workflows 01 and 02 call it
# from Code nodes with 30 s and 45 s request timeouts, so the service must answer, with a 503 if
# need be, before n8n's timeout hides the reason. The clock starts before the wait for a slot.
#   one lookup = resolve (0 GETs by page id, 1 by vanity URL or by domain) + the page view (1 GET)
#                + up to BRAND_SSR_RETRIES misses; measured 1.2 to 1.8 s per GET plus pacing,
#                so 4 to 8 s typical
# Before every GET after the first, the limiter's next free slot plus a page's worst case
# (SPACING_MAX_S + 5 s) is priced against what is left; a GET that would not fit is a 503
# (BudgetExceeded), and the GET itself is given the remaining time as its timeout.
BRAND_BUDGET_S=25
BRAND_SSR_RETRIES=2

# When the page plugin does not know a vanity handle, also fetch the profile page
# (facebook.com/<handle>) and read the page id from `delegate_page`. Off by default: it is the
# page class most likely to draw a fingerprint refusal, and stored page ids plus the plugin cover
# nearly every brand. Turn on after the deploy check in docs/deployment.md has shown the profile
# page is served to this address.
BRAND_PROFILE_FALLBACK=false

# Result cache, seconds. Stage 0 re-searches an exhausted keyword's remaining country slots and
# retries on error; the cache makes those free. Empty results expire sooner so a keyword that
# gets ads later is not pinned empty for a day. ~50 KB per entry; 2000 entries is ~100 MB at most.
CACHE_TTL_S=86400
CACHE_EMPTY_TTL_S=3600
CACHE_MAX_ENTRIES=2000

# Brand lookups keep their own short-lived cache: the page view under (page id, status, media)
# and a domain's resolved page id. 600 s covers 02's three calls per brand and the 01 -> 02
# hand-off, and lets a test run measure the site rather than the cache. A page id Meta does not
# know is kept for CACHE_EMPTY_TTL_S; a vanity or a domain that was not found is not kept.
ADYNTEL_CACHE_TTL_S=600

HOST=0.0.0.0
# 8000 is trustpilot-reviews and 8001 is reddit-reviews on the same Docker network; 8002 is the
# production container, 8003 the lanes container (docker-compose.lanes.yml, `.env.lanes`).
PORT=8002
