# Shared secret. n8n sends it as `Authorization: Bearer <token>`. Leave empty only for local testing.
API_TOKEN=

# Optional proxy for every request, passed straight to curl_cffi. Not needed on the primary path:
# the Ad Library is a logged-out public site and a clean IP at 4 requests a minute is expected to
# pass. Set it only if the server's IP is refused (see the README's diag section). Two forms:
#   http://user:pass@host:port      a plain proxy URL, used as-is
#   host:port:user:pass             four-field form (the password may itself contain ':')
# Use a STICKY port, never the rotating gateway (Decodo 7000, DataImpulse 823): a session's cookie
# jar and its IP are one identity to Meta, and a rotating exit changes the IP under it every call.
# Rotating ports are refused at startup.
SCRAPER_PROXY=

# Persisted-query id for AdLibrarySearchPaginationQuery. Leave empty: the service reads it from the
# page's own JS bundles when a session is minted (verified 2026-09-19, id 24922295957467452 lived in
# one of the 9 bundles as `__d("AdLibrarySearchPaginationQuery_facebookRelayOperation",...`). Set it
# only to pin a known-good value while the discovery regex is being fixed after a Meta change.
FB_DOC_ID=

# JSON object merged over the built-in GraphQL `variables` template, e.g. {"audienceTimeframe":"LAST_30_DAYS"}.
# This is the escape hatch for Meta adding or renaming a key: an env edit and a restart, not a build.
# Diff a real request in DevTools (Network tab, filter graphql, form field `variables`) to find the drift.
FB_VARIABLES_JSON=

# curl_cffi impersonation target. `chrome` is an alias for the newest Chrome the installed curl_cffi
# knows (chrome150 in 0.16.3). Meta rejects non-browser TLS with a 400 error page on every request
# after the challenge, measured 2026-09-19 with plain curl - so this is not a cosmetic setting.
FB_IMPERSONATE=chrome

# Per-request timeout, seconds. Measured 2026-09-19: a search page answers in ~1.1 s, the 570 KB
# bootstrap page in ~2 s. 30 leaves room for a slow Meta edge without eating the budget below.
REQUEST_TIMEOUT_S=30

# Ads per GraphQL page. 30 is what the site's own frontend requests; larger values are not honoured.
FB_PAGE_SIZE=30

# Hard cap on pages per search. Stage 0 asks for 80 ads = 3 pages of 30.
MAX_PAGES=3

# Searches that may run at once. Stage 0 sends one pair at a time; 2 covers an overlap between
# two hourly runs without doubling the request rate from this IP.
MAX_CONCURRENCY=2

# Warm sessions kept in the pool, round-robin by search, so one throttled session does not stall
# the batch. A session is one cookie jar (datr + rd_challenge) + one lsd token + one sessionID.
SESSION_POOL_SIZE=2

# A session is retired after this many GraphQL calls or this many seconds, whichever first.
# Unverified starting points from facebook.md; the rd_challenge clearance itself lasts 86400 s.
# Tune from /health: `sessions_retired` by reason shows which limit is actually being hit.
SESSION_MAX_REQUESTS=200
SESSION_MAX_AGE_S=7200

# Random gap between two calls on the same session, seconds. The site's own scroll pagination
# is human-paced; a fixed 0 s gap is the one pattern that looks nothing like it.
SPACING_MIN_S=2
SPACING_MAX_S=5

# Global ceiling on GraphQL calls per minute from this host, across all sessions. Stage 0 needs
# 3 calls per pair and 40 pairs an hour = 2 a minute; 4 leaves headroom for retries.
RATE_LIMIT_PER_MIN=4

# On GraphQL error 1675004 ("rate limit exceeded") the session sleeps this long and retries the
# page once; a second 1675004 retires it and a fresh session takes over.
RATE_LIMIT_SLEEP_S=60

# A session that returns this many consecutive empty first pages is retired as suspect (a soft
# block looks exactly like a keyword with no ads). Niche NZ/AU keywords are legitimately empty
# often, so this is deliberately not 1.
EMPTY_STREAK_RETIRE=5

# Wall-clock ceiling for one search, seconds. Nothing cancels a request once it starts, so the
# search stops starting pages it cannot finish and returns what it has with X-Truncated: true.
# Budget against Stage 0's 300 s node timeout:
#   one page   = SPACING_MAX_S + REQUEST_TIMEOUT_S + 60/RATE_LIMIT_PER_MIN = 5 + 30 + 15 = 50 s
#   one search = MAX_PAGES x 50 + RATE_LIMIT_SLEEP_S + ~5 s session mint    = 215 s worst case
# 240 sits between that and 300. Keep stop_grace_period in docker-compose.yml above this.
SCRAPE_BUDGET_S=240

# Result cache, seconds. Stage 0 re-searches an exhausted keyword's remaining country slots and
# retries on error; the cache makes those free. Empty results expire sooner so a soft block does
# not pin an empty answer for a day. ~50 KB per entry; 2000 entries is ~100 MB at the very most.
CACHE_TTL_S=86400
CACHE_EMPTY_TTL_S=3600
CACHE_MAX_ENTRIES=2000

HOST=0.0.0.0
# 8000 is trustpilot-reviews and 8001 is reddit-reviews on the same Docker network.
PORT=8002
